; quote / 字串 / and or / cond / let* / letrec / 不定參數
(write '(a b (c "str") 1.5)) (newline)
(display (and 1 2 3)) (display " ") (display (and 1 #f 3)) (display " ")
(display (or #f #f 7)) (display " ") (display (or)) (newline)
(define (sign x) (cond ((< x 0) 'negative) ((= x 0) 'zero) (else 'positive)))
(display (list (sign -5) (sign 0) (sign 9))) (newline)
(display (let* ((x 2) (y (* x 3)) (z (+ x y))) (list x y z))) (newline)
(display (letrec ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1)))))
                  (od? (lambda (n) (if (= n 0) #f (ev? (- n 1))))))
           (ev? 1001))) (newline)
(define (sum . xs) (if (null? xs) 0 (+ (car xs) (apply2 sum (cdr xs)))))
(define (apply2 f l) (if (null? l) (f) (if (null? (cdr l)) (f (car l)) (f (car l) (cadr l)))))
(display (sum 1 2)) (newline)
(display (string-append "Hello, " "Lisp " (number->string 2026))) (newline)
(display (equal? '(1 (2 3)) (list 1 (list 2 3)))) (newline)
